# Data source
NUXT_TAG_DATA_SOURCE=supabase

# Admin
NUXT_SUBMIT_RATE_LIMIT_ATTEMPTS=10
NUXT_SUBMIT_RATE_LIMIT_WINDOW_MS=600000
NUXT_RUNTIME_ERROR_RATE_LIMIT_ATTEMPTS=20
NUXT_RUNTIME_ERROR_RATE_LIMIT_WINDOW_MS=600000

# Notifications
NUXT_RESEND_API_KEY=replace_with_resend_api_key
NUXT_ADMIN_NOTIFICATION_EMAIL=replace_with_admin_email
NUXT_FROM_EMAIL=Bike Tag <notifications@example.com>
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_SUBMIT_FAILURE_ALERT_THRESHOLD=3
NUXT_SUBMIT_FAILURE_ALERT_THRESHOLD_WINDOW_MS=600000
NUXT_SUBMIT_FAILURE_ALERT_ATTEMPTS=1
NUXT_SUBMIT_FAILURE_ALERT_WINDOW_MS=3600000

# Runtime error monitoring
NUXT_SENTRY_DSN=replace_with_sentry_dsn
NUXT_SENTRY_ENVIRONMENT=development
NUXT_SENTRY_RELEASE=replace_with_git_commit_sha

# Supabase
NUXT_SUPABASE_URL=replace_with_supabase_project_url
NUXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
NUXT_SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
NUXT_SUPABASE_STORAGE_BUCKET=bike_tag_photos
NUXT_SUPABASE_PENDING_STORAGE_BUCKET=bike_tag_pending_photos
NUXT_ADMIN_PHOTO_SIGNED_URL_TTL_SECONDS=28800

SUPABASE_PASSWORD=replace_with_supabase_password
